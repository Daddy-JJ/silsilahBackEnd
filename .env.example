PORT=5000
NODE_ENV=development

# MySQL / MariaDB XAMPP Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=silsilah_keluarga_db

# Shared Hosting Resource Optimization (Mitigasi NPROC 40/40)
# UV_THREADPOOL_SIZE=2
# DB_CONNECTION_LIMIT=2
# DB_QUEUE_LIMIT=50
# DB_CONNECT_TIMEOUT=10000

# JWT Configuration
JWT_SECRET=supersecretkey_silsilah_keluarga_2026_dev
JWT_EXPIRES_IN=7d

# Frontend CORS configuration (comma separated for multiple origins)
FRONTEND_URL=https://silsilahkeluarga.id,http://localhost:3000,http://localhost:3001

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# SMTP Transactional Email Configuration (cPanel Node.js App Production)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@silsilahkeluarga.id
SMTP_PASS=
SMTP_FROM_NAME=SilsilahKeluarga.id
SMTP_FROM_EMAIL=admin@silsilahkeluarga.id
